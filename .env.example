# CORE v2 v0.2.0-lab.3 — defaults READ ONLY; NEVER use LIVE/stage DB.
# Lab DB must have migrations 001-004 and a dedicated local DB role.
CORE_V2_PORT=18210
CORE_V2_HOST=127.0.0.1
CORE_V2_DATABASE_URL=postgresql://core_v2_lab:REPLACE_ME@127.0.0.1:15450/tala_core_v2_lab
CORE_V2_WRITES_ENABLED=false
# To test writes: explicitly set BOTH to true/isolated-lab on localhost
# with database name tala_core_v2_lab or tala_core_v2_test after migrations 001–003.
CORE_V2_RUNTIME=disabled
NODE_ENV=development
# Only for the one-time lab merchant seeding tool (not used by server):
# CORE_V2_LAB_MERCHANT_EMAIL=merchant@example.test
# CORE_V2_LAB_MERCHANT_PASSWORD=SET_AT_RUNTIME_NOT_IN_GIT
# CORE_V2_LAB_DRIVER_EMAIL=driver@example.test
# CORE_V2_LAB_DRIVER_PASSWORD=SET_AT_RUNTIME_NOT_IN_GIT
