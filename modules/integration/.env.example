# M11 isolated staging-only lab. Do not use on the Kali LIVE server.
NODE_ENV=test
CORE_V2_INTEGRATION_RUNTIME=isolated-lab
CORE_V2_INTEGRATION_WRITES_ENABLED=false
CORE_V2_INTEGRATION_LIVE_PAYMENTS_ENABLED=false
CORE_V2_INTEGRATION_PAYOUTS_ENABLED=false
# DB guards require an isolated database for each module within one
# disposable PostgreSQL 16 SERVER. No existing production volume/role.
INTEGRATION_CI_URL=postgresql://integration_ci:<local-test-password>@127.0.0.1:5432/tala_integration_v2_test
